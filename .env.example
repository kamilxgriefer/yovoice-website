# Firebase Web SDK config — same project as the Flutter app (yovoice-ec54a,
# "yo_voice (web)" app). Get these from Firebase Console > Project settings
# > General > Your apps, or ask a teammate who already has them.
#
# There is no auth-domain variable: the SDK's authDomain is always
# <PROJECT_ID>.firebaseapp.com (src/lib/firebase/auth-domain.ts), because
# Google rejects the auth.yovoice.app popup handler with redirect_uri_mismatch.
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN is no longer read; a stale value is ignored.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=yovoice-ec54a
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=yovoice-ec54a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Where "Launch Web App" / post-login redirects send signed-in users.
NEXT_PUBLIC_APP_URL=https://app.yovoice.app
